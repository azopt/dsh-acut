{
  "name": "dsh-acut",
  "version": "0.1.0",
  "description": "Screenshot plugin for DeepSeek Harness: region capture, annotation, scrolling long capture with a live stitched preview, and pin-to-screen — the same engine is exposed to the agent as a screenshot tool. · 截图插件：区域框选、标注、滚屏长截图、悬浮预览、钉住置顶，并提供 Agent 截图工具。",
  "type": "module",
  "main": "./src/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "screenshot",
    "scrolling-screenshot",
    "annotation",
    "pin-to-screen",
    "capture"
  ],
  "license": "MIT",
  "author": "Azopt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azopt/dsh-acut.git"
  },
  "homepage": "https://github.com/Azopt/dsh-acut#readme",
  "bugs": {
    "url": "https://github.com/Azopt/dsh-acut/issues"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
